# Pebbles College International School - Environment Configuration
# Copy this file to .env and fill in your details. Do not commit .env to version control.

# Flask settings
SECRET_KEY=your_secret_key_here

# Database connection URL
# Examples:
# PostgreSQL: postgresql://username:password@localhost:5432/pebbles_db
# MySQL: mysql+pymysql://username:password@localhost:3306/pebbles_db
# SQLite (default fallback): sqlite:///school.db
DATABASE_URL=sqlite:///school.db
